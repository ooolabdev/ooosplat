{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OOOSplat",
  "version": "0.8.0",
  "identifier": "studio.ooo.splat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OOOSplat",
        "width": 1500,
        "height": 850,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#eef1f5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "resources": {
      "../.cache/html-viewer/runtime.js": "html-viewer/runtime.js",
      "../licenses/THIRD_PARTY_NOTICES.txt": "licenses/THIRD_PARTY_NOTICES.txt",
      "../licenses/Kamadak-Exif-BSD-2-Clause.txt": "licenses/Kamadak-Exif-BSD-2-Clause.txt",
      "../licenses/FFmpeg-LGPL-2.1.txt": "licenses/FFmpeg-LGPL-2.1.txt",
      "../licenses/FFmpeg-LGPL-3.0.txt": "licenses/FFmpeg-LGPL-3.0.txt",
      "../licenses/FFmpeg-GPL-3.0.txt": "licenses/FFmpeg-GPL-3.0.txt",
      "../licenses/COLMAP-LICENSE.txt": "licenses/COLMAP-LICENSE.txt",
      "../licenses/NVIDIA-CUDA-Runtime.txt": "licenses/NVIDIA-CUDA-Runtime.txt",
      "../licenses/Brush-LICENSE.txt": "licenses/Brush-LICENSE.txt",
      "../licenses/PlayCanvas-MIT.txt": "licenses/PlayCanvas-MIT.txt",
      "../licenses/Niantic-SPZ-MIT.txt": "licenses/Niantic-SPZ-MIT.txt",
      "../licenses/Mediabunny-MPL-2.0.txt": "licenses/Mediabunny-MPL-2.0.txt",
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../TRADEMARK_POLICY.md": "TRADEMARK_POLICY.md",
      "../GENERATED_OUTPUTS.md": "GENERATED_OUTPUTS.md"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "compression": "bzip2"
      }
    }
  }
}
