{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run verify:engines && npm run verify:licenses && npm run build"
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "resources": {
      "../engines/manifest.linux.json": "engines/manifest.linux.json",
      "../engines/linux/brush/brush_app": "engines/linux/brush/brush_app",
      "../engines/linux/brush/LICENSE": "engines/linux/brush/LICENSE",
      "../engines/linux/brush/BUILDINFO.json": "engines/linux/brush/BUILDINFO.json",
      "../engines/linux/brush/INSTALL-INFO.json": "engines/linux/brush/INSTALL-INFO.json",
      "../engines/linux/brush/UPSTREAM-SHA256SUMS": "engines/linux/brush/UPSTREAM-SHA256SUMS",
      "../engines/linux/brush/UPSTREAM-README.md": "engines/linux/brush/UPSTREAM-README.md",
      "../engines/linux/colmap/bin/": "engines/linux/colmap/bin/",
      "../engines/linux/colmap/lib/": "engines/linux/colmap/lib/",
      "../engines/linux/colmap/licenses/": "engines/linux/colmap/licenses/",
      "../engines/linux/colmap/BUILD-INFO.json": "engines/linux/colmap/BUILD-INFO.json",
      "../engines/linux/colmap/BUNDLED-COMPONENTS.json": "engines/linux/colmap/BUNDLED-COMPONENTS.json",
      "../engines/linux/colmap/SHA256SUMS": "engines/linux/colmap/SHA256SUMS"
    },
    "linux": {
      "deb": {
        "depends": ["ffmpeg"],
        "recommends": ["libvulkan1", "mesa-vulkan-drivers"],
        "section": "graphics",
        "priority": "optional"
      }
    }
  }
}
