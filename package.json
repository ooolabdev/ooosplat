{
  "name": "ooo-splat",
  "private": true,
  "version": "0.2.0",
  "license": "Apache-2.0",
  "author": "ooolabdev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ooolabdev/ooosplat.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "setup:engines": "node scripts/engine-command.mjs setup",
    "verify:engines": "node scripts/engine-command.mjs verify",
    "verify:licenses": "node scripts/verify-licenses.mjs",
    "setup:engines:windows": "powershell -ExecutionPolicy Bypass -File scripts/setup-engines.ps1",
    "verify:engines:windows": "powershell -ExecutionPolicy Bypass -File scripts/verify-engines.ps1",
    "verify:licenses:windows": "powershell -ExecutionPolicy Bypass -File scripts/verify-licenses.ps1",
    "setup:engines:linux": "bash scripts/setup-engines-linux.sh",
    "verify:engines:linux": "bash scripts/verify-engines-linux.sh",
    "verify:licenses:linux": "node scripts/verify-licenses.mjs",
    "start:app:linux": "bash scripts/start-app-linux.sh",
    "build:bundle": "npm run verify:engines && npm run verify:licenses && npm run build",
    "build:bundle:windows": "npm run verify:engines:windows && npm run verify:licenses:windows && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "lucide-react": "^0.539.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2",
    "vite": "^8.1.0",
    "vitest": "^3.2.4"
  }
}
